{
  "title": "Order pipeline",
  "uid": "order-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "tags": ["event-driven-orders"],
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Orders accepted per second",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
     "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{method=\"POST\",uri=\"/orders\"}[15s]))", "legendFormat": "POST /orders"}]},
    {"id": 2, "type": "timeseries", "title": "Orders finished per second (by outcome)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
     "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (outcome, cause) (rate(orders_saga_completed_total[15s]))", "legendFormat": "{{outcome}} {{cause}}"}]},
    {"id": 3, "type": "timeseries", "title": "Payments per second (SIMULATED gateway)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
     "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(payments_processed_total[15s]))", "legendFormat": "{{outcome}}"}]},
    {"id": 4, "type": "timeseries", "title": "Outbox backlog (rows waiting)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "outbox_pending", "legendFormat": "pending"}]},
    {"id": 5, "type": "timeseries", "title": "Oldest unpublished outbox row",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "outbox_oldest_pending_age_seconds", "legendFormat": "age"}]},
    {"id": 6, "type": "timeseries", "title": "Outbox relay throughput (rows per second)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
     "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "rate(outbox_relay_published_total[15s])", "legendFormat": "rows/s"}]},
    {"id": 7, "type": "timeseries", "title": "Kafka consumer lag (max records)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "max by (job, topic) (kafka_consumer_fetch_manager_records_lag_max)", "legendFormat": "{{job}} {{topic}}"}]},
    {"id": 8, "type": "timeseries", "title": "Listener busy threads",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (job) (rate(spring_kafka_listener_seconds_sum[15s]))", "legendFormat": "{{job}}"}]},
    {"id": 9, "type": "timeseries", "title": "Average time per message",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (job) (rate(spring_kafka_listener_seconds_sum[15s])) / sum by (job) (rate(spring_kafka_listener_seconds_count[15s]))", "legendFormat": "{{job}}"}]},
    {"id": 10, "type": "timeseries", "title": "Database connections",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "max by (job) (hikaricp_connections_active)", "legendFormat": "{{job}} active"},
       {"refId": "B", "expr": "max by (job) (hikaricp_connections_pending)", "legendFormat": "{{job}} waiting"}]},
    {"id": 11, "type": "timeseries", "title": "Payment breaker (0 closed, 1 half-open, 2 open)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 2}, "overrides": []},
     "targets": [{"refId": "A", "expr": "payment_breaker_state", "legendFormat": "breaker"}]},
    {"id": 12, "type": "timeseries", "title": "CPU (service JVMs and whole machine)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "max by (job) (process_cpu_usage)", "legendFormat": "{{job}}"},
       {"refId": "B", "expr": "max(system_cpu_usage)", "legendFormat": "whole machine"}]}
  ]
}
